    "type-check": "tsc --noEmit",
    "watch": "rslib build -w"
  },
  "dependencies": {
    "@antv/event-emitter": "^0.1.3",
    "@antv/g6": "^5.0.45",
    "@antv/graphin": "workspace:^",
    "@antv/util": "^3.3.10",
    "@tanstack/react-query": "^5.74.4",
    "antd": "^5.24.8",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "less": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "peerDependencies": {
    "less": "^4.2.0",
    "react": "^18.0.0 || ^19.1.0",
    "react-dom": "^18.0.0 || ^19.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
