{
  "name": "@antv/gi-sdk",
  "version": "3.0.0",
  "type": "module",
  "description": "SDK for Graph Insight Application",
  "repository": {
    "type": "git",
    "url": "https://github.com/antvis/Graphin.git"
  },
  "license": "ISC",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "ci": "run-s type-check lint build",
