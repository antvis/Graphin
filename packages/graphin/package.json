{
  "name": "@antv/graphin",
  "type": "module",
  "version": "3.0.4",
  "description": "A React toolkit for graph analysis based on g6",
  "repository": {
    "type": "git",
    "url": "https://github.com/antvis/Graphin.git"
  },
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "ci": "run-s type-check lint build",
    "dev": "vite",
    "fix": "eslint ./src --fix && prettier ./src --write ",
    "lint": "eslint ./src --quiet && prettier ./src --check",
    "prepublishOnly": "pnpm run ci",
    "readme": "node ./scripts/copy-readme.mjs",
    "type-check": "tsc --noEmit",
    "watch": "rslib build -w"
  },
  "dependencies": {
    "@antv/g6": "^5.0.45"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "antd": "^5.24.8",
    "less": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.1.0",
    "react-dom": "^18.0.0 || ^19.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
